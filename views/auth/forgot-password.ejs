<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Şifremi Unuttum | Psikolojik Destek Platformu</title>
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            margin: 0;
            padding: 0;
            background-color: #f5f5f5;
            color: #333;
            line-height: 1.6;
        }
        
        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 20px;
        }
        
        header {
            background-color: #4b6cb7;
            color: #fff;
            padding: 1rem 0;
            box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
        }
        
        header .container {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        
        .logo {
            font-size: 1.8rem;
            font-weight: bold;
        }
        
        nav ul {
            display: flex;
            list-style: none;
        }
        
        nav ul li {
            margin-left: 20px;
        }
        
        nav ul li a {
            color: #fff;
            text-decoration: none;
            transition: color 0.3s;
        }
        
        nav ul li a:hover {
            color: #ddd;
        }
        
        .auth-container {
            max-width: 450px;
            margin: 60px auto;
            background-color: white;
            padding: 30px;
            border-radius: 8px;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
        }
        
        .auth-header {
            text-align: center;
            margin-bottom: 30px;
        }
        
        .auth-header h1 {
            color: #4b6cb7;
            font-size: 1.8rem;
            margin-bottom: 10px;
        }
        
        .auth-form .form-group {
            margin-bottom: 20px;
        }
        
        .auth-form label {
            display: block;
            font-weight: 600;
            margin-bottom: 7px;
            color: #555;
        }
        
        .auth-form input {
            width: 100%;
            padding: 12px;
            font-size: 1rem;
            border: 1px solid #ddd;
            border-radius: 4px;
            box-sizing: border-box;
        }
        
        .auth-form .btn {
            background-color: #4b6cb7;
            color: white;
            padding: 12px 20px;
            border: none;
            border-radius: 4px;
            width: 100%;
            font-size: 1rem;
            cursor: pointer;
            transition: background-color 0.3s;
        }
        
        .auth-form .btn:hover {
            background-color: #3a5491;
        }
        
        .auth-links {
            margin-top: 25px;
            text-align: center;
        }
        
        .auth-links a {
            color: #4b6cb7;
            text-decoration: none;
            transition: color 0.3s;
        }
        
        .auth-links a:hover {
            text-decoration: underline;
        }
        
        .alert {
            padding: 12px;
            margin-bottom: 20px;
            border-radius: 4px;
            font-weight: bold;
        }
        
        .alert-danger {
            background-color: #f8d7da;
            color: #721c24;
        }
        
        .alert-success {
            background-color: #d4edda;
            color: #155724;
        }
        
        footer {
            background-color: #333;
            color: white;
            padding: 20px 0;
            text-align: center;
            margin-top: 60px;
        }
    </style>
</head>
<body>
    <header>
        <div class="container">
            <div class="logo">Psikolojik Destek Platformu</div>
            <nav>
                <ul>
                    <li><a href="/">Ana Sayfa</a></li>
                    <li><a href="/terapistler">Terapistler</a></li>
                    <li><a href="/hizmetler">Hizmetler</a></li>
                    <li><a href="/hakkimizda">Hakkımızda</a></li>
                    <li><a href="/auth/login">Giriş Yap</a></li>
                    <li><a href="/auth/register">Kayıt Ol</a></li>
                </ul>
            </nav>
        </div>
    </header>
    
    <div class="container">
        <div class="auth-container">
            <div class="auth-header">
                <h1>Şifremi Unuttum</h1>
                <p>Hesabınıza ait e-posta adresini girin ve size şifre sıfırlama bağlantısı gönderelim</p>
            </div>
            
            <!-- Hata mesajı için alan -->
            <% if (locals.error) { %>
            <div class="alert alert-danger">
                <%= error %>
            </div>
            <% } %>
            
            <!-- Başarı mesajı için alan -->
            <% if (locals.success) { %>
            <div class="alert alert-success">
                <%= success %>
            </div>
            <% } %>
            
            <form action="/api/auth/forgot-password" method="POST" class="auth-form" id="forgotPasswordForm">
                <div class="form-group">
                    <label for="email">E-posta</label>
                    <input type="email" id="email" name="email" required autocomplete="email">
                </div>
                
                <button type="submit" class="btn">Şifre Sıfırlama Bağlantısı Gönder</button>
            </form>
            
            <div class="auth-links">
                <a href="/auth/login">Giriş yapmayı deneyin</a> veya <a href="/auth/register">yeni bir hesap oluşturun</a>
            </div>
        </div>
    </div>
    
    <footer>
        <div class="container">
            &copy; <%= new Date().getFullYear() %> Psikolojik Destek Platformu. Tüm hakları saklıdır.
        </div>
    </footer>

    <script>
    document.addEventListener('DOMContentLoaded', function() {
        const form = document.getElementById('forgotPasswordForm');
        
        form.addEventListener('submit', async function(e) {
            e.preventDefault();
            
            // Form verilerini topla
            const formData = {
                email: document.getElementById('email').value.trim()
            };
            
            try {
                const response = await fetch('/api/auth/forgot-password', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(formData)
                });
                
                const data = await response.json();
                
                if (!response.ok) {
                    // Hata durumunda
                    const errorDiv = document.createElement('div');
                    errorDiv.className = 'alert alert-danger';
                    errorDiv.textContent = data.message || 'Şifre sıfırlama isteği sırasında bir hata oluştu.';
                    
                    const existingAlert = form.querySelector('.alert');
                    if (existingAlert) {
                        existingAlert.remove();
                    }
                    
                    form.insertBefore(errorDiv, form.firstChild);
                } else {
                    // Başarılı işlem
                    const successDiv = document.createElement('div');
                    successDiv.className = 'alert alert-success';
                    successDiv.textContent = data.message || 'Şifre sıfırlama bağlantısı e-posta adresinize gönderildi. Lütfen e-postanızı kontrol edin.';
                    
                    form.reset();
                    
                    const existingAlert = form.querySelector('.alert');
                    if (existingAlert) {
                        existingAlert.remove();
                    }
                    
                    form.insertBefore(successDiv, form.firstChild);
                }
            } catch (err) {
                console.error('Şifre sıfırlama hatası:', err);
                
                const errorDiv = document.createElement('div');
                errorDiv.className = 'alert alert-danger';
                errorDiv.textContent = 'Sunucu hatası: Lütfen daha sonra tekrar deneyin.';
                
                const existingAlert = form.querySelector('.alert');
                if (existingAlert) {
                    existingAlert.remove();
                }
                
                form.insertBefore(errorDiv, form.firstChild);
            }
        });
    });
    </script>
</body>
</html>