<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kayıt Ol | Psikolojik Destek Platformu</title>
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            margin: 0;
            padding: 0;
            background-color: #f5f5f5;
            color: #333;
            line-height: 1.6;
        }
        
        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 20px;
        }
        
        header {
            background-color: #4b6cb7;
            color: #fff;
            padding: 1rem 0;
            box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
        }
        
        header .container {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        
        .logo {
            font-size: 1.8rem;
            font-weight: bold;
        }
        
        nav ul {
            display: flex;
            list-style: none;
        }
        
        nav ul li {
            margin-left: 20px;
        }
        
        nav ul li a {
            color: #fff;
            text-decoration: none;
            transition: color 0.3s;
        }
        
        nav ul li a:hover {
            color: #ddd;
        }
        
        .auth-container {
            max-width: 550px;
            margin: 40px auto;
            background-color: white;
            padding: 30px;
            border-radius: 8px;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
        }
        
        .auth-header {
            text-align: center;
            margin-bottom: 25px;
        }
        
        .auth-header h1 {
            color: #4b6cb7;
            font-size: 1.8rem;
            margin-bottom: 10px;
        }
        
        .auth-form .form-group {
            margin-bottom: 20px;
        }
        
        .auth-form label {
            display: block;
            font-weight: 600;
            margin-bottom: 7px;
            color: #555;
        }
        
        .auth-form input[type="text"],
        .auth-form input[type="email"],
        .auth-form input[type="password"],
        .auth-form input[type="tel"],
        .auth-form select {
            width: 100%;
            padding: 12px;
            font-size: 1rem;
            border: 1px solid #ddd;
            border-radius: 4px;
            box-sizing: border-box;
        }
        
        .auth-form .btn {
            background-color: #4b6cb7;
            color: white;
            padding: 12px 20px;
            border: none;
            border-radius: 4px;
            width: 100%;
            font-size: 1rem;
            cursor: pointer;
            transition: background-color 0.3s;
        }
        
        .auth-form .btn:hover {
            background-color: #3a5491;
        }
        
        .form-row {
            display: flex;
            gap: 15px;
        }
        
        .form-row .form-group {
            flex: 1;
        }
        
        .auth-links {
            margin-top: 20px;
            text-align: center;
        }
        
        .auth-links a {
            color: #4b6cb7;
            text-decoration: none;
            transition: color 0.3s;
        }
        
        .auth-links a:hover {
            text-decoration: underline;
        }
        
        .alert {
            padding: 12px;
            margin-bottom: 20px;
            border-radius: 4px;
            font-weight: bold;
        }
        
        .alert-danger {
            background-color: #f8d7da;
            color: #721c24;
        }
        
        .alert-success {
            background-color: #d4edda;
            color: #155724;
        }
        
        .terms {
            display: flex;
            align-items: flex-start;
            margin-bottom: 20px;
        }
        
        .terms input {
            margin-right: 10px;
            margin-top: 5px;
        }
        
        .terms label {
            font-weight: normal;
            font-size: 0.9rem;
        }
        
        .role-selector {
            margin-bottom: 25px;
            text-align: center;
        }
        
        .role-selector h3 {
            margin-bottom: 15px;
            color: #555;
        }
        
        .role-options {
            display: flex;
            gap: 15px;
            justify-content: center;
        }
        
        .role-option {
            flex: 1;
            border: 2px solid #ddd;
            border-radius: 8px;
            padding: 15px;
            text-align: center;
            cursor: pointer;
            transition: all 0.3s;
        }
        
        .role-option.active {
            border-color: #4b6cb7;
            background-color: rgba(75, 108, 183, 0.05);
        }
        
        .role-option h4 {
            color: #4b6cb7;
            margin-top: 0;
        }
        
        footer {
            background-color: #333;
            color: white;
            padding: 20px 0;
            text-align: center;
            margin-top: 60px;
        }
    </style>
</head>
<body>
    <header>
        <div class="container">
            <div class="logo">Psikolojik Destek Platformu</div>
            <nav>
                <ul>
                    <li><a href="/">Ana Sayfa</a></li>
                    <li><a href="/terapistler">Terapistler</a></li>
                    <li><a href="/hizmetler">Hizmetler</a></li>
                    <li><a href="/hakkimizda">Hakkımızda</a></li>
                    <li><a href="/auth/login">Giriş Yap</a></li>
                    <li><a href="/auth/register">Kayıt Ol</a></li>
                </ul>
            </nav>
        </div>
    </header>
    
    <div class="container">
        <div class="auth-container">
            <div class="auth-header">
                <h1>Hesap Oluştur</h1>
                <p>Platformumuza kayıt olarak terapi seanslarına hemen başlayabilirsiniz</p>
            </div>
            
            <!-- Hata mesajı için alan -->
            <% if (locals.error) { %>
            <div class="alert alert-danger">
                <%= error %>
            </div>
            <% } %>
            
            <!-- Başarı mesajı için alan -->
            <% if (locals.success) { %>
            <div class="alert alert-success">
                <%= success %>
            </div>
            <% } %>
            
            <!-- Rol seçimi -->
            <div class="role-selector">
                <h3>Hesap Türü Seçin</h3>
                <div class="role-options">
                    <div class="role-option active" data-role="client" id="clientRole">
                        <h4>Danışan</h4>
                        <p>Terapi hizmeti almak için</p>
                    </div>
                    <div class="role-option" data-role="therapist" id="therapistRole">
                        <h4>Terapist</h4>
                        <p>Terapi hizmeti vermek için</p>
                    </div>
                </div>
            </div>
            
            <form action="/api/auth/register" method="POST" class="auth-form" id="registerForm">
                <input type="hidden" name="role" id="roleInput" value="client">
                
                <div class="form-row">
                    <div class="form-group">
                        <label for="firstName">Ad</label>
                        <input type="text" id="firstName" name="firstName" required>
                    </div>
                    
                    <div class="form-group">
                        <label for="lastName">Soyad</label>
                        <input type="text" id="lastName" name="lastName" required>
                    </div>
                </div>
                
                <div class="form-group">
                    <label for="email">E-posta</label>
                    <input type="email" id="email" name="email" required autocomplete="email">
                </div>
                
                <div class="form-group">
                    <label for="phone">Telefon</label>
                    <input type="tel" id="phone" name="phone" placeholder="5XX XXX XXXX" required>
                </div>
                
                <div class="form-row">
                    <div class="form-group">
                        <label for="password">Şifre</label>
                        <input type="password" id="password" name="password" required autocomplete="new-password">
                    </div>
                    
                    <div class="form-group">
                        <label for="confirmPassword">Şifre (Tekrar)</label>
                        <input type="password" id="confirmPassword" name="confirmPassword" required autocomplete="new-password">
                    </div>
                </div>
                
                <!-- Terapiste özel alanlar - başlangıçta gizli -->
                <div id="therapistFields" style="display: none;">
                    <div class="form-group">
                        <label for="specialty">Uzmanlık Alanı</label>
                        <select id="specialty" name="specialty">
                            <option value="">Seçiniz...</option>
                            <option value="klinik_psikoloji">Klinik Psikoloji</option>
                            <option value="cocuk_ergen">Çocuk ve Ergen Psikolojisi</option>
                            <option value="cift_aile">Çift ve Aile Terapisi</option>
                            <option value="travma">Travma ve TSSB</option>
                            <option value="bagimlilik">Bağımlılık Terapisi</option>
                            <option value="bilişsel_davranisci">Bilişsel Davranışçı Terapi</option>
                            <option value="cinsel_terapi">Cinsel Terapi</option>
                            <option value="diger">Diğer</option>
                        </select>
                    </div>
                    
                    <div class="form-group">
                        <label for="bio">Profesyonel Biyografi (Danışanlara Görünecek)</label>
                        <textarea id="bio" name="bio" rows="4"></textarea>
                    </div>
                    
                    <div class="form-group">
                        <label for="experience">Deneyim (Yıl)</label>
                        <input type="number" id="experience" name="experience" min="0" max="70">
                    </div>
                </div>
                
                <div class="terms">
                    <input type="checkbox" id="termsAgreement" name="termsAgreement" required>
                    <label for="termsAgreement">
                        <a href="/kullanim-kosullari" target="_blank">Kullanım Koşulları</a>'nı ve 
                        <a href="/gizlilik-politikasi" target="_blank">Gizlilik Politikası</a>'nı okudum ve kabul ediyorum.
                    </label>
                </div>
                
                <button type="submit" class="btn">Kayıt Ol</button>
            </form>
            
            <div class="auth-links">
                Zaten bir hesabınız var mı? <a href="/auth/login">Giriş Yap</a>
            </div>
        </div>
    </div>
    
    <footer>
        <div class="container">
            &copy; <%= new Date().getFullYear() %> Psikolojik Destek Platformu. Tüm hakları saklıdır.
        </div>
    </footer>

    <script>
    document.addEventListener('DOMContentLoaded', function() {
        // Rol seçimi işlemleri
        const clientRole = document.getElementById('clientRole');
        const therapistRole = document.getElementById('therapistRole');
        const roleInput = document.getElementById('roleInput');
        const therapistFields = document.getElementById('therapistFields');
        
        clientRole.addEventListener('click', function() {
            clientRole.classList.add('active');
            therapistRole.classList.remove('active');
            roleInput.value = 'client';
            therapistFields.style.display = 'none';
        });
        
        therapistRole.addEventListener('click', function() {
            therapistRole.classList.add('active');
            clientRole.classList.remove('active');
            roleInput.value = 'therapist';
            therapistFields.style.display = 'block';
        });
        
        // Form gönderimini ele al
        const form = document.getElementById('registerForm');
        
        form.addEventListener('submit', async function(e) {
            e.preventDefault();
            
            // Şifre doğrulama kontrolü
            const password = document.getElementById('password').value;
            const confirmPassword = document.getElementById('confirmPassword').value;
            
            if (password !== confirmPassword) {
                const errorDiv = document.createElement('div');
                errorDiv.className = 'alert alert-danger';
                errorDiv.textContent = 'Şifreler eşleşmiyor.';
                
                const existingAlert = form.querySelector('.alert');
                if (existingAlert) {
                    existingAlert.remove();
                }
                
                form.insertBefore(errorDiv, form.firstChild);
                return;
            }
            
            // Form verilerini topla
            const formData = {
                firstName: document.getElementById('firstName').value.trim(),
                lastName: document.getElementById('lastName').value.trim(),
                email: document.getElementById('email').value.trim(),
                phone: document.getElementById('phone').value.trim(),
                password: password,
                role: roleInput.value
            };
            
            // Eğer terapist ise, ekstra alanları ekle
            if (formData.role === 'therapist') {
                formData.specialty = document.getElementById('specialty').value;
                formData.bio = document.getElementById('bio').value;
                formData.experience = document.getElementById('experience').value;
            }
            
            try {
                const response = await fetch('/api/auth/register', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(formData)
                });
                
                const data = await response.json();
                
                if (!response.ok) {
                    // Hata durumunda
                    const errorDiv = document.createElement('div');
                    errorDiv.className = 'alert alert-danger';
                    errorDiv.textContent = data.message || 'Kayıt işlemi sırasında bir hata oluştu.';
                    
                    const existingAlert = form.querySelector('.alert');
                    if (existingAlert) {
                        existingAlert.remove();
                    }
                    
                    form.insertBefore(errorDiv, form.firstChild);
                } else {
                    // Başarılı kayıt
                    const successDiv = document.createElement('div');
                    successDiv.className = 'alert alert-success';
                    successDiv.textContent = 'Kayıt işleminiz başarıyla tamamlandı. E-posta adresinize doğrulama bağlantısı gönderildi.';
                    
                    // Formu temizle
                    form.reset();
                    
                    const existingAlert = form.querySelector('.alert');
                    if (existingAlert) {
                        existingAlert.remove();
                    }
                    
                    form.insertBefore(successDiv, form.firstChild);
                    
                    // 3 saniye sonra giriş sayfasına yönlendir
                    setTimeout(() => {
                        window.location.href = '/auth/login?registered=true';
                    }, 3000);
                }
            } catch (err) {
                console.error('Kayıt hatası:', err);
                
                const errorDiv = document.createElement('div');
                errorDiv.className = 'alert alert-danger';
                errorDiv.textContent = 'Sunucu hatası: Lütfen daha sonra tekrar deneyin.';
                
                const existingAlert = form.querySelector('.alert');
                if (existingAlert) {
                    existingAlert.remove();
                }
                
                form.insertBefore(errorDiv, form.firstChild);
            }
        });
    });
    </script>
</body>
</html>