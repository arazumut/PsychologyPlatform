<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Şifre Sıfırla | Psikolojik Destek Platformu</title>
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            margin: 0;
            padding: 0;
            background-color: #f5f5f5;
            color: #333;
            line-height: 1.6;
        }
        
        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 20px;
        }
        
        header {
            background-color: #4b6cb7;
            color: #fff;
            padding: 1rem 0;
            box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
        }
        
        header .container {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        
        .logo {
            font-size: 1.8rem;
            font-weight: bold;
        }
        
        nav ul {
            display: flex;
            list-style: none;
        }
        
        nav ul li {
            margin-left: 20px;
        }
        
        nav ul li a {
            color: #fff;
            text-decoration: none;
            transition: color 0.3s;
        }
        
        nav ul li a:hover {
            color: #ddd;
        }
        
        .auth-container {
            max-width: 450px;
            margin: 60px auto;
            background-color: white;
            padding: 30px;
            border-radius: 8px;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
        }
        
        .auth-header {
            text-align: center;
            margin-bottom: 30px;
        }
        
        .auth-header h1 {
            color: #4b6cb7;
            font-size: 1.8rem;
            margin-bottom: 10px;
        }
        
        .auth-form .form-group {
            margin-bottom: 20px;
        }
        
        .auth-form label {
            display: block;
            font-weight: 600;
            margin-bottom: 7px;
            color: #555;
        }
        
        .auth-form input {
            width: 100%;
            padding: 12px;
            font-size: 1rem;
            border: 1px solid #ddd;
            border-radius: 4px;
            box-sizing: border-box;
        }
        
        .auth-form .btn {
            background-color: #4b6cb7;
            color: white;
            padding: 12px 20px;
            border: none;
            border-radius: 4px;
            width: 100%;
            font-size: 1rem;
            cursor: pointer;
            transition: background-color 0.3s;
        }
        
        .auth-form .btn:hover {
            background-color: #3a5491;
        }
        
        .auth-links {
            margin-top: 25px;
            text-align: center;
        }
        
        .auth-links a {
            color: #4b6cb7;
            text-decoration: none;
            transition: color 0.3s;
        }
        
        .auth-links a:hover {
            text-decoration: underline;
        }
        
        .alert {
            padding: 12px;
            margin-bottom: 20px;
            border-radius: 4px;
            font-weight: bold;
        }
        
        .alert-danger {
            background-color: #f8d7da;
            color: #721c24;
        }
        
        .alert-success {
            background-color: #d4edda;
            color: #155724;
        }
        
        footer {
            background-color: #333;
            color: white;
            padding: 20px 0;
            text-align: center;
            margin-top: 60px;
        }
        
        .password-strength {
            margin-top: 5px;
            font-size: 0.9rem;
        }
        
        .strength-meter {
            height: 5px;
            width: 100%;
            background-color: #e9ecef;
            margin-top: 5px;
            border-radius: 3px;
            overflow: hidden;
        }
        
        .strength-meter-fill {
            height: 100%;
            width: 0;
            transition: width 0.5s;
            background-color: #dc3545; /* Başlangıçta kırmızı */
        }
        
        .strength-text {
            font-size: 0.8rem;
            margin-top: 5px;
        }
    </style>
</head>
<body>
    <header>
        <div class="container">
            <div class="logo">Psikolojik Destek Platformu</div>
            <nav>
                <ul>
                    <li><a href="/">Ana Sayfa</a></li>
                    <li><a href="/terapistler">Terapistler</a></li>
                    <li><a href="/hizmetler">Hizmetler</a></li>
                    <li><a href="/hakkimizda">Hakkımızda</a></li>
                    <li><a href="/auth/login">Giriş Yap</a></li>
                    <li><a href="/auth/register">Kayıt Ol</a></li>
                </ul>
            </nav>
        </div>
    </header>
    
    <div class="container">
        <div class="auth-container">
            <div class="auth-header">
                <h1>Şifre Sıfırla</h1>
                <p>Lütfen yeni şifrenizi belirleyin</p>
            </div>
            
            <!-- Hata mesajı için alan -->
            <% if (locals.error) { %>
            <div class="alert alert-danger">
                <%= error %>
            </div>
            <% } %>
            
            <!-- Başarı mesajı için alan -->
            <% if (locals.success) { %>
            <div class="alert alert-success">
                <%= success %>
            </div>
            <% } %>
            
            <form action="/api/auth/reset-password/<%= token %>" method="PUT" class="auth-form" id="resetPasswordForm">
                <input type="hidden" id="token" value="<%= token %>" />
                
                <div class="form-group">
                    <label for="password">Yeni Şifre</label>
                    <input type="password" id="password" name="password" required minlength="6" autocomplete="new-password">
                    
                    <div class="password-strength">
                        <div class="strength-meter">
                            <div class="strength-meter-fill" id="strengthMeter"></div>
                        </div>
                        <div class="strength-text" id="strengthText">Şifre gücü: Zayıf</div>
                    </div>
                </div>
                
                <div class="form-group">
                    <label for="confirmPassword">Yeni Şifre (Tekrar)</label>
                    <input type="password" id="confirmPassword" name="confirmPassword" required minlength="6" autocomplete="new-password">
                </div>
                
                <button type="submit" class="btn">Şifremi Sıfırla</button>
            </form>
            
            <div class="auth-links">
                <a href="/auth/login">Giriş yapmayı deneyin</a>
            </div>
        </div>
    </div>
    
    <footer>
        <div class="container">
            &copy; <%= new Date().getFullYear() %> Psikolojik Destek Platformu. Tüm hakları saklıdır.
        </div>
    </footer>

    <script>
    document.addEventListener('DOMContentLoaded', function() {
        const form = document.getElementById('resetPasswordForm');
        const passwordInput = document.getElementById('password');
        const confirmInput = document.getElementById('confirmPassword');
        const strengthMeter = document.getElementById('strengthMeter');
        const strengthText = document.getElementById('strengthText');
        
        // Şifre gücünü ölç
        function checkPasswordStrength(password) {
            let strength = 0;
            
            if (password.length >= 8) strength += 1;
            if (password.match(/[a-z]+/)) strength += 1;
            if (password.match(/[A-Z]+/)) strength += 1;
            if (password.match(/[0-9]+/)) strength += 1;
            if (password.match(/[^a-zA-Z0-9]+/)) strength += 1;
            
            return strength;
        }
        
        // Şifre girişini izle
        passwordInput.addEventListener('input', function() {
            const val = passwordInput.value;
            const strength = checkPasswordStrength(val);
            
            // Şifre gücü göstergesini güncelle
            strengthMeter.style.width = `${strength * 20}%`;
            
            // Renk ve metin güncelle
            if (strength < 2) {
                strengthMeter.style.backgroundColor = '#dc3545'; // kırmızı
                strengthText.textContent = 'Şifre gücü: Zayıf';
            } else if (strength < 4) {
                strengthMeter.style.backgroundColor = '#ffc107'; // sarı
                strengthText.textContent = 'Şifre gücü: Orta';
            } else {
                strengthMeter.style.backgroundColor = '#28a745'; // yeşil
                strengthText.textContent = 'Şifre gücü: Güçlü';
            }
        });
        
        form.addEventListener('submit', async function(e) {
            e.preventDefault();
            
            // Şifre eşleşmesini kontrol et
            const password = passwordInput.value;
            const confirmPassword = confirmInput.value;
            
            if (password !== confirmPassword) {
                const errorDiv = document.createElement('div');
                errorDiv.className = 'alert alert-danger';
                errorDiv.textContent = 'Şifreler eşleşmiyor.';
                
                const existingAlert = form.querySelector('.alert');
                if (existingAlert) {
                    existingAlert.remove();
                }
                
                form.insertBefore(errorDiv, form.firstChild);
                return;
            }
            
            // Form verilerini topla
            const token = document.getElementById('token').value;
            const formData = {
                password
            };
            
            try {
                const response = await fetch(`/api/auth/reset-password/${token}`, {
                    method: 'PUT',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(formData)
                });
                
                const data = await response.json();
                
                if (!response.ok) {
                    // Hata durumunda
                    const errorDiv = document.createElement('div');
                    errorDiv.className = 'alert alert-danger';
                    errorDiv.textContent = data.message || 'Şifre sıfırlama sırasında bir hata oluştu.';
                    
                    const existingAlert = form.querySelector('.alert');
                    if (existingAlert) {
                        existingAlert.remove();
                    }
                    
                    form.insertBefore(errorDiv, form.firstChild);
                } else {
                    // Başarılı işlem
                    const successDiv = document.createElement('div');
                    successDiv.className = 'alert alert-success';
                    successDiv.textContent = data.message || 'Şifreniz başarıyla sıfırlandı. Giriş sayfasına yönlendiriliyorsunuz.';
                    
                    form.reset();
                    
                    const existingAlert = form.querySelector('.alert');
                    if (existingAlert) {
                        existingAlert.remove();
                    }
                    
                    form.insertBefore(successDiv, form.firstChild);
                    
                    // 3 saniye sonra giriş sayfasına yönlendir
                    setTimeout(() => {
                        window.location.href = '/auth/login';
                    }, 3000);
                }
            } catch (err) {
                console.error('Şifre sıfırlama hatası:', err);
                
                const errorDiv = document.createElement('div');
                errorDiv.className = 'alert alert-danger';
                errorDiv.textContent = 'Sunucu hatası: Lütfen daha sonra tekrar deneyin.';
                
                const existingAlert = form.querySelector('.alert');
                if (existingAlert) {
                    existingAlert.remove();
                }
                
                form.insertBefore(errorDiv, form.firstChild);
            }
        });
    });
    </script>
</body>
</html>