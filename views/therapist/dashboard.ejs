                                <a href="/therapist/sessions/204/reschedule" class="btn btn-sm btn-outline">Ertele</a>
                            </div>
                        </div>
                        
                        <div class="session-card">
                            <div class="session-info">
                                <h3>
                                    <img src="/images/client5.jpg" alt="Client" class="profile-pic">
                                    Can Yücel
                                </h3>
                                <p><i class="far fa-calendar-alt"></i> Yarın, 15:30-16:30</p>
                                <p><i class="fas fa-video"></i> Video Görüşme</p>
                                <span class="session-status status-scheduled">Planlandı</span>
                            </div>
                            <div class="session-actions">
                                <a href="/therapist/sessions/205/notes" class="btn btn-sm btn-outline">Notlar</a>
                                <a href="/therapist/clients/105" class="btn btn-sm btn-outline">Danışan Bilgileri</a>
                                <a href="/therapist/sessions/205/reschedule" class="btn btn-sm btn-outline">Ertele</a>
                            </div>
                        </div>
                        
                        <div class="session-card">
                            <div class="session-info">
                                <h3>
                                    <img src="/images/client1.jpg" alt="Client" class="profile-pic">
                                    Ahmet Yılmaz
                                </h3>
                                <p><i class="far fa-calendar-alt"></i> 5 Mayıs 2025, 14:30-15:30</p>
                                <p><i class="fas fa-video"></i> Video Görüşme</p>
                                <span class="session-status status-scheduled">Planlandı</span>
                            </div>
